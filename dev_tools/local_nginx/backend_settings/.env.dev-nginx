# This is the example .env file for the TUD backend application.
#
# Adapt the settings as needed.
#
# The backend code loads the .env file from its current working
# directory, i.e., from where uvicorn/gunicorn was started.
#
# You can also set the env variables in your shell environment before/when running uvicorn,
# and they will take precedence over the values in this file.
#

TUD_DATABASE_USER=timeusediary_user
TUD_DATABASE_PASSWORD=timeusediary_password
TUD_DATABASE_HOST=localhost
TUD_DATABASE_PORT=5432
TUD_DATABASE_NAME=timeusediary_db
TUD_DATABASE_URL=postgresql://timeusediary_user:timeusediary_password@localhost:5432/timeusediary_db
# Origins allowed to call the API (CORS). The app itself goes through nginx on
# its own origin, but direct API use does (admin pages, tests, a browser on
# another machine). run_dev_nginx_both.bash appends this machine's LAN address
# to the generated backend/.env, so testing from a phone works without editing
# this file.
TUD_ALLOWED_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'
TUD_REPORT_DB_CONTENTS_ON_STARTUP=true
TUD_API_ADMIN_USERNAME=timeusediary_api_admin
TUD_API_ADMIN_PASSWORD=timeusediary_api_admin_password
# Scientist accounts: scoped admins that may only manage the studies they own
# plus the studies listed in their "studies" list. Optional (JSON list).
TUD_API_SCIENTISTS='[{"name": "test_scientist_alpha", "password": "test-scientist-alpha-password-do-not-use-in-production", "studies": ["default"]}, {"name": "test_scientist_beta", "password": "test-scientist-beta-password-do-not-use-in-production", "studies": []}]'
# Backup accounts: read-only, server-wide accounts restricted to the three
# /api/admin/{studies,participants,activities} extraction endpoints. Optional.
TUD_API_BACKUP_USERS='[{"name": "test_backup_bot", "password": "test-backup-bot-password-do-not-use-in-production"}]'
TUD_ROOTPATH=/tud_backend
# Base URL the backend redirects to (thank-you page, timeout page, tasks).
# run_dev_nginx_both.bash rewrites this to this machine's LAN address, because
# the redirect has to be reachable from the device the participant uses (a phone
# cannot resolve 'localhost'). Set TUD_DEV_LAN_IP to override the detection.
TUD_FRONTEND_URL=http://localhost:3000/report/
# Server-wide legal pages, shown to participants in the footer (desktop) and the
# menu. A study can hide them with "hide_server_wide_links" in its config.
# Leave empty to render nothing.
TUD_IMPRINT_URL=https://www.aesthetics.mpg.de/en/imprint.html
TUD_PRIVACY_URL=https://www.aesthetics.mpg.de/en/data-protection-information.html
TUD_EXTERNAL_TASK_HMAC_SECRETS='{"test_hmac_key":"integration-test-secret-do-not-use-in-production"}'

