{
  "name": "trac-frontend",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Participant diary frontend. No bundler: ES modules and plain CSS, served statically.",
  "scripts": {
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "check:architecture": "node tools/check-architecture.mjs",
    "typecheck": "tsc -p jsconfig.json",
    "test": "npm run test:unit && npm run check:architecture && npm run typecheck",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:components": "playwright test --config playwright.components.config.js",
    "sync:admin-tokens": "node tools/sync-admin-tokens.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.55.0",
    "typescript": "^7.0.2"
  }
}
