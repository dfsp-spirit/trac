# This is the example .env file for the TUD backend application.
#
# Adapt the settings as needed.
#
# The backend code loads the .env file from its current working
# directory, i.e., from where uvicorn/gunicorn was started.
#
# You can also set the env variables in your shell environment before/when running uvicorn,
# and they will take precedence over the values in this file.
#

TUD_DATABASE_USER=timeusediary_user
TUD_DATABASE_PASSWORD=timeusediary_password
TUD_DATABASE_HOST=localhost
TUD_DATABASE_PORT=5432
TUD_DATABASE_NAME=timeusediary_db
TUD_DATABASE_URL=postgresql://timeusediary_user:timeusediary_password@localhost:5432/timeusediary_db
TUD_ALLOWED_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'
TUD_REPORT_DB_CONTENTS_ON_STARTUP=true  # Whether to print info about DB contents when the app starts to console. Useful in development.
# Single admin pair (backward-compatible):
TUD_API_ADMIN_USERNAME=timeusediary_api_admin
TUD_API_ADMIN_PASSWORD=timeusediary_api_admin_password
# Multiple admin pairs (optional JSON lists, same length required):
# TUD_API_ADMIN_USERNAME='["admin1", "admin2"]'
# TUD_API_ADMIN_PASSWORD='["password1", "password2"]'
# Scientist accounts (optional): scoped admins that may fully manage the studies
# they own, and additionally any study listed in their "studies" list (name_short).
# A study created by a scientist is owned by that scientist. A username must not
# appear both here and in TUD_API_ADMIN_USERNAME. See README.md, section
# 'Study ownership and scientist accounts'.
# TUD_API_SCIENTISTS='[{"name": "alice", "password": "secret1", "studies": ["study_a"]}, {"name": "bob", "password": "secret2"}]'
# Backup accounts (optional): read-only, server-wide accounts that may only use
# the data-extraction endpoints (GET /api/admin/studies, /api/admin/participants,
# GET /api/admin/activities) - meant for a script that copies data into a
# separate system. Every other admin route returns HTTP 403 for them, regardless
# of study ownership, and they accept no "studies" list because they are not
# scoped to studies. A username must not appear in TUD_API_ADMIN_USERNAME or
# TUD_API_SCIENTISTS. See README.md, section 'Read-only backup accounts'.
# TUD_API_BACKUP_USERS='[{"name": "backup_bot", "password": "secret3"}]'
# Dedicated persistent admin-audit log (separate logger output):
TUD_ADMIN_AUDIT_LOG_FILE=admin_actions.log
TUD_ADMIN_AUDIT_LOG_MAX_BYTES=5242880
TUD_ADMIN_AUDIT_LOG_BACKUP_COUNT=10
TUD_ROOTPATH=/
TUD_FRONTEND_URL=http://localhost:3000/report/
# Server-wide legal pages, shown to participants in the footer (desktop) and the
# menu. A study can hide them with "hide_server_wide_links" in its config.
# Leave empty to render nothing.
TUD_IMPRINT_URL=https://www.aesthetics.mpg.de/en/imprint.html
TUD_PRIVACY_URL=https://www.aesthetics.mpg.de/en/data-protection-information.html
# External task HMAC secrets for callback signing, keyed by reference name.
# Each external task can optionally reference a key via "hmac_secret_reference".
# The actual secret values are stored here, never in the study config file.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# TUD_EXTERNAL_TASK_HMAC_SECRETS='{"survey_hub_v1":"a1b2c3...","payments_v2":"d4e5f6..."}'
# Test secret used by integration tests; keep in sync with the value used
# in test_external_task_hmac_callback.py.
TUD_EXTERNAL_TASK_HMAC_SECRETS='{"test_hmac_key":"integration-test-secret-do-not-use-in-production"}'

# Field encryption for proxy studies (parent-child rosters).
# A column whose name ends in "_encrypted" stores a token sealed with these
# keys. Comma-separated, 32 bytes each as base64url (43 characters) or hex
# (64 characters). The FIRST key encrypts; ALL keys decrypt, so a rotation
# means prepending a new key and keeping the old one until the rows are
# re-written. Never lose the key: without it, encrypted names are unreadable.
# Generate with: python3 -c "import os,base64;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# The format is agreed with the KI; see dev_tools/plans/proxy_studies.md §7.
# Hex form is accepted too (64 characters):
# TUD_FIELD_ENCRYPTION_KEYS='0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef'
# Test key used by the unit tests; keep in sync with tests/unit/test_encrypted_fields.py.
TUD_FIELD_ENCRYPTION_KEYS='dHJhYy11bml0LXRlc3Qta2V5LTMyYnl0ZXMtcGFkISE='
